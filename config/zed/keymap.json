// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
    {
        "context": "GitPanel",
        "bindings": {
            "cmd-enter": "git::Commit",
            "cmd-k": "git_panel::ToggleFocus",
        },
    },
    {
        "bindings": {
            "cmd-g cmd-l": "git::Pull",
            "cmd-g cmd-a": "git::StageAll",
            "cmd-g cmd-p": "git::Push",
            "cmd-g cmd-d": "git::Diff",
            "cmd-alt-c": [
                "agent::NewExternalAgentThread",
                { "agent": { "custom": { "name": "claude-acp" } } },
            ],
        },
    },
    {
        "context": "Workspace",
        "bindings": {
            // "shift shift": "file_finder::Toggle"
            "cmd-left": "project_panel::CollapseAllEntries",
            // Cycle through tabs without going through the tab_switcher,
            // which leaves focus stuck in the switcher when landing on a
            // terminal tab (requiring a click to focus the terminal).
            "ctrl-tab": "pane::ActivateNextItem",
            "ctrl-shift-tab": "pane::ActivateLastItem",
        },
    },
    {
        "context": "Editor",
        "bindings": {
            // "j k": ["workspace::SendKeystrokes", "escape"]
            "cmd-i": "editor::GoToDefinition",
            "cmd-u": "editor::FindAllReferences",
            "cmd-k": "git_panel::ToggleFocus",
        },
    },
    {
        "context": "ProjectPanel",
        "bindings": {
            // "j k": ["workspace::SendKeystrokes", "escape"]
            "cmd-k": "git_panel::ToggleFocus",
        },
    },
    {
        "context": "Terminal",
        "bindings": {
            "shift-enter": ["terminal::SendText", "\u001b[13;2u"],
            "ctrl--": ["terminal::SendText", "\u001b[45;5u"],
            "ctrl-alt-]": ["terminal::SendText", "\u001b[93;7u"],
            "cmd-shift-z": "workspace::ToggleZoom",
            "alt-n": ["terminal::SendText", "~"],
            "alt-shift-9": ["terminal::SendText", "["],
            "alt-shift-0": ["terminal::SendText", "]"],
            "alt-shift-l": ["terminal::SendText", "|"],
            "alt-/": ["terminal::SendText", "\\"],
        },
    },
]
