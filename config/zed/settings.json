// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
    "cli_default_open_behavior": "new_window",
    "agent_servers": {
        "mistral-vibe": {
            "type": "registry"
        },
        "claude-acp": {
            "favorite_config_option_values": {
                "mode": [
                    "auto"
                ]
            },
            "default_config_options": {
                "fast": false,
                "model": "default",
                "mode": "auto",
                "effort": "high"
            },
            "type": "registry"
        }
    },
    "project_panel": {
        "dock": "left"
    },
    "outline_panel": {
        "dock": "left"
    },
    "collaboration_panel": {
        "dock": "left"
    },
    "git_panel": {
        "dock": "left"
    },
    "agent": {
        "terminal_init_command": "codex",
        "commit_message_model": {
          "provider": "openai",
          "model": "gpt-5.4-mini"
        },
        "profiles": {
            "ask": {
                "name": "Ask",
                "tools": {
                    "create_thread": true,
                    "diagnostics": true,
                    "ask_user": false,
                    "fetch": true,
                    "list_agents_and_models": true,
                    "list_directory": true,
                    "find_path": true,
                    "find_references": true,
                    "get_code_actions": true,
                    "go_to_definition": true,
                    "read_file": true,
                    "grep": true,
                    "skill": true,
                    "spawn_agent": true,
                    "search_web": true
                },
                "enable_all_context_servers": false,
                "context_servers": {}
            }
        },
        "dock": "right",
        "use_modifier_to_send": true,
        "default_model": {
            "provider": "mistral",
            "model": "codestral-latest",
        },
    },
    "telemetry": {
        "diagnostics": false,
        "metrics": false,
    },
    "ui_font_size": 16,
    "buffer_font_size": 14,
    "theme": {
        "mode": "system",
        "light": "One Light",
        "dark": "Catppuccin Macchiato",
    },
    "base_keymap": "VSCode",
    "autosave": "on_focus_change",
    "gutter": {
        "line_numbers": true,
    },
    "tab_size": 4,
    "languages": {
        "YAML": {
            "tab_size": 2,
            "format_on_save": "off",
        },
        "TOML": {
            "tab_size": 2,
            "format_on_save": "off",
        },
        "Helm": {
            "tab_size": 2,
        },
        "Shell Script": {
            "tab_size": 2,
        },
    },
    "show_edit_predictions": false,
    "terminal": {
        "font_family": "JetBrains Mono",
        "font_size": 13,
        "line_height": "standard",
        "cursor_shape": "block",
        "blinking": "off",
        "option_as_meta": false,
        "minimum_contrast": 0,
    },
}
