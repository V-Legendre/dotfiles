// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
    "ssh_connections": [
    {
      "host": "oh-api-worker",
      "projects": [
        {
          "paths": [
            "/home/ouihelp"
          ]
        }
      ]
    }
  ],
    "agent": {
        "default_model": {
            "provider": "copilot_chat",
            "model": "gpt-4.1"
        },
        "version": "2"
    },
    "telemetry": {
        "diagnostics": false,
        "metrics": false
    },
    "ui_font_size": 16,
    "buffer_font_size": 14,
    "theme": {
        "mode": "system",
        "light": "One Light",
        "dark": "One Dark"
    },
    "base_keymap": "VSCode",
    "autosave": "on_focus_change",
    "gutter": {
        "line_numbers": true
    },
    "tab_size": 4,
    "languages": {
        "YAML": {
            "tab_size": 2,
            "format_on_save": "off"
        },
        "TOML": {
            "tab_size": 2,
            "format_on_save": "off"
        },
        "Jinja2": {
            "tab_size": 2
        }
    }
}
