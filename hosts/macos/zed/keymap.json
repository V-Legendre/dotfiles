// Zed keymap — macOS overlay.
//
// Merged after shared/zed/keymap.base.json by install.sh.
// The `[` and `]` below must stay alone on their own lines (the merge is textual).
[
    {
        "context": "GitPanel",
        "bindings": {
            "cmd-enter": "git::Commit",
            "cmd-k": "git_panel::ToggleFocus",
        },
    },
    {
        "bindings": {
            "cmd-g cmd-l": "git::Pull",
            "cmd-g cmd-a": "git::StageAll",
            "cmd-g cmd-p": "git::Push",
            "cmd-g cmd-d": "git::Diff",
            "cmd-alt-c": [
                "agent::NewExternalAgentThread",
                { "agent": { "custom": { "name": "claude-acp" } } },
            ],
        },
    },
    {
        "context": "Workspace",
        "bindings": {
            // "shift shift": "file_finder::Toggle"
            "cmd-left": "project_panel::CollapseAllEntries",
        },
    },
    {
        "context": "Editor",
        "bindings": {
            // "j k": ["workspace::SendKeystrokes", "escape"]
            "cmd-i": "editor::GoToDefinition",
            "cmd-u": "editor::FindAllReferences",
            "cmd-k": "git_panel::ToggleFocus",
        },
    },
    {
        "context": "ProjectPanel",
        "bindings": {
            "cmd-k": "git_panel::ToggleFocus",
        },
    },
    {
        "context": "Terminal",
        "bindings": {
            "cmd-shift-z": "workspace::ToggleZoom",
            // macOS remaps option-<key>, so the AZERTY symbols have to be
            // re-sent by hand. On Linux AltGr produces them natively.
            "alt-n": ["terminal::SendText", "~"],
            "alt-9": ["terminal::SendText", "{"],
            "alt-shift-9": ["terminal::SendText", "["],
            "alt-0": ["terminal::SendText", "}"],
            "alt-shift-0": ["terminal::SendText", "]"],
            "alt-shift-l": ["terminal::SendText", "|"],
            "alt-/": ["terminal::SendText", "\\"],
        },
    },
]
