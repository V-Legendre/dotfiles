// Folder-specific settings
//
// For a full list of overridable settings, and general information on folder-specific settings,
// see the documentation: https://zed.dev/docs/configuring-zed#settings-files
{
    "languages": {
        "Python": {
            // `ty` for type checking, `ruff` for lint/format. Both are picked up
            // from .venv/bin (see the `ty`/`ruff` pins in pyproject.toml), so the
            // editor, pre-commit and CI all run the same versions.
            "language_servers": ["ty", "ruff"],
            "format_on_save": "on",
            // Applied consecutively: sort imports, apply the remaining lint
            // autofixes, then format. Sorting is driven by the `I` rules and the
            // `src` roots declared in pyproject.toml.
            "formatter": [
                { "code_action": "source.organizeImports.ruff" },
                { "code_action": "source.fixAll.ruff" },
                { "language_server": { "name": "ruff" } },
            ],
        },
    },

    "lsp": {
        // ty reads [tool.ty] from pyproject.toml: interpreter, first-party roots
        // and excludes are configured there, not here.
        "ruff": {
            // Use the ruff pinned in pyproject.toml instead of the copy Zed downloads
            // (currently 0.16), whose default rule set is far wider than 0.15.5's —
            // without this, format-on-save and `source.fixAll` rewrite code that
            // pre-commit and CI would leave alone.
            "binary": {
                "path": ".venv/bin/ruff",
                "arguments": ["server"],
                "ignore_system_version": true,
            },
            "initialization_options": {
                "settings": {
                    "configuration": "./pyproject.toml",
                    "logLevel": "info",
                },
            },
        },
    },

    "tab_size": 4,
}
