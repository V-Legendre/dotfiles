[
    {
        "label": "Helm upgrade oh-api",
        "command": "helm upgrade oh-api . --install --wait --namespace oh-api",
        "cwd": "${ZED_WORKTREE_ROOT}/helm",
    },
    {
        "label": "Download AWS config (dev)",
        "command": "uv run scripts/utils/aws-config-download",
        "cwd": "${ZED_WORKTREE_ROOT}",
    },
    {
        "label": "k9s -n oh-api",
        "command": "k9s -n oh-api",
        "cwd": "${ZED_WORKTREE_ROOT}",
    },
    {
        "label": "Pulumi up (app)",
        "command": "pulumi up",
        "cwd": "${ZED_WORKTREE_ROOT}/pulumi/app",
    },
    {
        "label": "Pulumi preview (app)",
        "command": "pulumi preview --diff",
        "cwd": "${ZED_WORKTREE_ROOT}/pulumi/app",
    },
    {
        "label": "Pulumi up (dynamic_envs)",
        "command": "pulumi up",
        "cwd": "${ZED_WORKTREE_ROOT}/pulumi/dynamic_envs",
    },
    {
        "label": "Pulumi preview (dynamic_envs)",
        "command": "pulumi preview --diff",
        "cwd": "${ZED_WORKTREE_ROOT}/pulumi/dynamic_envs",
    },
    {
        "label": "mise db-revision",
        "command": "Mise db-revision",
        "cwd": "${ZED_WORKTREE_ROOT}",
    },
]
